{
  // GoldenBead. Phase 0: Scope & Sequence 6-12 for teachers, behind one shared password.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldenbead",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.goldenbead.org", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the login check first, including images.
    "run_worker_first": true
  },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
  // Secrets (set with `npx wrangler secret put`, never written in this repo):
  //   SITE_PASSWORD   the shared teacher password
  //   SESSION_SECRET  a long random string that signs the login cookie
}
